# The core pipeline needs no credentials — the Federal Reserve yield-curve
# data (feds200628.csv) is publicly downloaded by src/pull_fed_yield_curve.py.
#
# Setting WRDS_USERNAME below (requires a WRDS account) enables the optional
# CRSP Treasury pull (doit pull:crsp_treasury), which powers the reproduction of
# GSW (2007) Figures 1, 2, and 6 in the gsw_crsp_replication_ipynb notebook.
# Store your password in ~/.pgpass (see the wrds package docs). Leave this unset
# to run the credential-free pipeline; the notebook then builds mostly empty
# with instructions.
WRDS_USERNAME=your_wrds_username
